{
  "cli": {
    "version": ">= 10.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "autoIncrement": true
    },
    "analyzerx-3.31.0-local-ai": {
      "distribution": "internal",
      "env": {
        "ANALYZERX_RELEASE_VERSION": "3.31.0",
        "ANALYZERX_ANDROID_VERSION_CODE": "33100",
        "ANALYZERX_IOS_BUILD_NUMBER": "33100",
        "ANALYZERX_ENABLE_NATIVE_LOCAL_AI": "true"
      },
      "android": {
        "buildType": "apk"
      }
    }
  }
}

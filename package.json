{
  "name": "app-template",
  "version": "3.2.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "android": "react-native run-android",
    "apk:checksum": "node scripts/checksum-artifact.mjs",
    "build": "pnpm build:server",
    "build:server": "esbuild server/_core/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "check": "tsc --noEmit",
    "db:push": "drizzle-kit generate && drizzle-kit migrate",
    "dev": "concurrently -k \"pnpm dev:server\" \"pnpm dev:metro\"",
    "dev:metro": "cross-env NODE_ENV=development react-native start --port ${EXPO_PORT:-8081}",
    "dev:server": "cross-env NODE_ENV=development tsx watch server/_core/index.ts",
    "format": "prettier --write .",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "qr": "node scripts/generate_qr.mjs",
    "release:verify": "node scripts/verify-release.mjs",
    "start": "NODE_ENV=production node dist/index.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-clipboard/clipboard": "^1.16.3",
    "@react-native-community/datetimepicker": "^9.1.0",
    "@react-native-documents/picker": "^12.0.2",
    "@react-navigation/bottom-tabs": "^7.8.12",
    "@react-navigation/elements": "^2.9.2",
    "@react-navigation/native": "^7.1.25",
    "@react-navigation/native-stack": "7.8.6",
    "@tanstack/react-query": "^5.90.12",
    "@trpc/client": "11.7.2",
    "@trpc/react-query": "11.7.2",
    "@trpc/server": "11.19.0",
    "axios": "^1.20.0",
    "clsx": "^2.1.1",
    "cookie": "^1.1.1",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.45.4",
    "expo": "~54.0.29",
    "expo-audio": "~1.1.0",
    "expo-notifications": "~0.32.15",
    "express": "^4.22.1",
    "india-stock-mcp": "1.0.1",
    "jose": "6.1.0",
    "mysql2": "^3.24.5",
    "nativewind": "^4.2.1",
    "pako": "^2",
    "pdfkit": "^0.19.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-device-info": "^15.0.2",
    "react-native-fs": "^2.20.0",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-haptic-feedback": "^3.0.0",
    "react-native-image-picker": "^8.3.0",
    "react-native-inappbrowser-reborn": "^3.7.1",
    "react-native-keychain": "^10.0.0",
    "react-native-print": "^0.11.0",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-reanimated": "~4.1.6",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.16.0",
    "react-native-share": "^12.3.1",
    "react-native-svg": "15.12.1",
    "react-native-udp": "^4.1.7",
    "react-native-vector-icons": "^10.2.0",
    "react-native-web": "~0.21.2",
    "react-native-worklets": "0.5.1",
    "superjson": "^1.13.3",
    "tailwind-merge": "^2.6.0",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@react-native/babel-preset": "^0.88.0",
    "@react-native/metro-config": "^0.88.0",
    "@types/cookie": "^0.6.0",
    "@types/express": "^4.17.25",
    "@types/node": "^22.19.3",
    "@types/pdfkit": "^0.17.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "~19.1.17",
    "@types/react-native-vector-icons": "^6.4.18",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "drizzle-kit": "^0.31.8",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.2",
    "eslint-config-expo": "~10.0.0",
    "prettier": "^3.7.4",
    "qrcode": "^1.5.4",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "vitest": "^2.1.9"
  },
  "packageManager": "pnpm@9.12.0"
}
